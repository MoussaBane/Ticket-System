# ====================================
# Production Environment Configuration
# ====================================
# Copy this to .env in production and fill with actual values

# Server Configuration
PORT=10000
NODE_ENV=production
BASE_URL=https://your-app.onrender.com

# Database Configuration
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/ticket_system?retryWrites=true&w=majority

# JWT Configuration (CRITICAL: Use a strong random 32+ character string)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=3h

# ====================================
# Security Checklist
# ====================================
# ✓ Change JWT_SECRET to a cryptographically secure random string
# ✓ Use MongoDB Atlas IP whitelist (or allow all: 0.0.0.0/0 for Render)
# ✓ Ensure DB user has minimal required permissions
# ✓ Update BASE_URL to match your Render domain
# ✓ Never commit this file to git

# ====================================
# TICKET SYSTEM ENVIRONMENT VARIABLES
# ====================================

# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ====================================
# DATABASE CONFIGURATION (MongoDB)
# ====================================

# Option 1: Full MongoDB URI (recommended)
DB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ticket_system?retryWrites=true&w=majority

# Option 2: Username and Password (if using Atlas)
# DB_USERNAME=your_mongo_user
# DB_PASSWORD=your_mongo_password

# Note: If DB_URI is not set, the system will attempt to use DB_USERNAME and DB_PASSWORD

# ====================================
# JWT CONFIGURATION
# ====================================

# Generate a secure 32+ character string for production
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_in_production
JWT_EXPIRES_IN=3h

# ====================================
# SEEDING & DEMO DATA (Development Only)
# ====================================

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASS=AdminPass123

SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASS=ManagerPass123

ENABLE_SEEDING=false

# ====================================
# NOTES
# ====================================
# 1. Copy this file to .env and fill in your values
# 2. Never commit the actual .env file to version control
# 3. In production, use a secret manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 4. JWT_SECRET must be at least 32 characters for security
# 5. Ensure database credentials are kept secure

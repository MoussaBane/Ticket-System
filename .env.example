# ====================================
# Ticket Management System Environment
# ====================================

# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database Configuration (MongoDB)
# Option 1: Full MongoDB URI
DB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ticket_system?retryWrites=true&w=majority

# Option 2: Username and Password (builds URI automatically)
# DB_USERNAME=your_mongo_user
# DB_PASSWORD=your_mongo_password

# Fallback MongoDB connection (used if above are not set)
# Requires DB_USERNAME and DB_PASSWORD environment variables

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=3h

# Email Configuration (Nodemailer)
# For Gmail: Use App Password (not regular password) with 2FA enabled
# See: https://support.google.com/accounts/answer/185833
MAIL_SERVICE=gmail
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
MAIL_NAME=Event Team

# Ticket PDF Background
# URL to background image used in PDF tickets
TICKET_BACKGROUND_URL=/background.png

# ====================================
# Seed User Credentials (Development)
# ====================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASS=AdminPass123

SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASS=ManagerPass123

# ====================================
# Notes
# ====================================
# 1. Change JWT_SECRET to a secure random string in production
# 2. Use environment-specific config in production
# 3. Never commit actual .env file to repository
# 4. For local development, create .env file from this template

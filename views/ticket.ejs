<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body { margin:0; padding:0; }
    .ticket { position: relative; width:600px; height:300px; font-family: Arial, sans-serif; }
    .bg { position:absolute; top:0; left:0; width:100%; height:100%; }
    .content { position:absolute; top:0; left:0; width:100%; height:100%; padding:20px; }
    .name { position:absolute; top:40%; left:10%; font-size:20px; font-weight:bold; color:#222 }
    .code { position:absolute; bottom:15%; left:10%; font-size:16px; color:#222 }
    .qrcode { position:absolute; bottom:10%; right:10%; width:100px; height:100px; }
  </style>
</head>
<body>
  <div class="ticket">
    <img src="<%= backgroundUrl %>" class="bg" />
    <div class="content">
      <div class="name"><%= assignedTo || 'INVITÉ' %></div>
      <div class="code">Code : <%= code %></div>
      <img src="<%= qrData %>" class="qrcode" />
    </div>
  </div>
</body>
</html>
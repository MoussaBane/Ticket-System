{
  "name": "ticket-system",
  "version": "5.0.0",
  "description": "Professional event ticket management system with frontend/backend separation, VIP/NORMAL types, QR codes, and role-based access control",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "backend": "node backend/server.js",
    "backend:dev": "nodemon backend/server.js",
    "seed:users": "node backend/scripts/seedUsers.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ticket-system",
    "pm2:restart": "pm2 restart ticket-system",
    "pm2:logs": "pm2 logs ticket-system",
    "pm2:delete": "pm2 delete ticket-system",
    "logs:create": "mkdir -p logs",
    "audit:security": "npm audit",
    "audit:fix": "npm audit fix",
    "security:check": "node scripts/security-audit.js",
    "test": "echo \"No tests specified\" && exit 1"
  },
  "keywords": [
    "ticket",
    "management",
    "event",
    "qrcode",
    "jwt",
    "mongodb",
    "express",
    "refactored",
    "production-ready"
  ],
  "author": "Moussa BANE",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "jimp": "^0.22.12",
    "jose": "^5.2.0",
    "json2csv": "^6.0.0-alpha.2",
    "mongoose": "^8.14.0",
    "qrcode": "^1.5.4",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
